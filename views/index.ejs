<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>PropScholar Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/daisyui@4.4.24/dist/full.min.css" rel="stylesheet"/>
</head>

<body class="bg-[#0B0F19] text-gray-200">

  <!-- NAV -->
  <div class="navbar bg-[#111827] border-b border-gray-800 px-6">
      <div class="flex-1">
        <h1 class="text-2xl font-semibold text-blue-400">PropScholar AI Dashboard</h1>
      </div>
      <div class="flex-none gap-2">
        <a href="/admin/new" class="btn btn-primary btn-sm">➕ Add New KB</a>
        <button id="deleteSelectedBtn" class="btn btn-error btn-sm hidden">🗑 Delete Selected</button>
      </div>
  </div>

  <div class="px-8 py-6">

    <!-- SEARCH -->
    <input 
      id="search"
      class="input input-bordered w-full bg-[#111827] border-gray-700 text-gray-300 mb-6"
      placeholder="Search knowledge base…"
      onkeyup="searchKB()"
    />

    <!-- TABLE -->
    <div class="overflow-x-auto bg-[#111827] rounded-xl p-4 border border-gray-800">
      <table class="table table-zebra w-full text-gray-300">
        <thead>
          <tr>
            <th><input type="checkbox" onchange="toggleAll(this)"/></th>
            <th>#</th>
            <th>Title</th>
            <th>Category</th>
            <th>Preview</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody id="kbTable">
          <% docs.forEach((d, i) => { %>
          <tr class="kb-row">
            <td>
              <input type="checkbox" class="rowCheck" data-id="<%= d._id %>"/>
            </td>
            <td><%= i + 1 %></td>
            <td><%= d.title %></td>
            <td><span class="badge badge-primary"><%= d.category %></span></td>
            <td class="max-w-xs truncate text-gray-400"><%= d.content.substring(0, 70) %>...</td>
            <td>
              <a href="/admin/edit/<%= d._id %>" class="btn btn-info btn-xs">Edit</a>
              <a href="/admin/delete/<%= d._id %>" class="btn btn-error btn-xs">Delete</a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  </div>

  <script>
    function searchKB() {
      const term = document.getElementById("search").value.toLowerCase();
      document.querySelectorAll(".kb-row").forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(term) ? "" : "none";
      });
    }

    function toggleAll(el) {
      document.querySelectorAll(".rowCheck").forEach(c => c.checked = el.checked);
      checkSelection();
    }

    document.querySelectorAll(".rowCheck").forEach(c =>
      c.addEventListener("change", checkSelection)
    );

    function checkSelection() {
      const selected = Array.from(document.querySelectorAll(".rowCheck"))
                      .filter(x => x.checked).length;
      document.getElementById("deleteSelectedBtn").classList.toggle("hidden", selected === 0);
    }

    document.getElementById("deleteSelectedBtn").addEventListener("click", async () => {
      const ids = Array.from(document.querySelectorAll(".rowCheck"))
        .filter(x => x.checked)
        .map(x => x.dataset.id);

      if (!confirm(`Delete ${ids.length} KB items?`)) return;

      await fetch("/admin/delete-multiple", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ids })
      });

      location.reload();
    });
  </script>

</body>
</html>
