<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Train Bot - PropScholar Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/daisyui@4.4.24/dist/full.min.css" rel="stylesheet"/>
  <style>
    body { margin: 0; padding: 0; overflow: hidden; }
    .chat-container { height: 100vh; display: flex; flex-direction: column; background: #0D0F19; }
    .messages-area { flex: 1; overflow-y: auto; padding: 20px; }
    .message { margin-bottom: 16px; display: flex; align-items: flex-start; animation: slideIn 0.3s; }
    @keyframes slideIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .message-user { justify-content: flex-end; }
    .message-bot { justify-content: flex-start; }
    .message-content { max-width: 70%; padding: 12px 16px; border-radius: 12px; position: relative; }
    .message-user .message-content { background: #0EA5E9; color: white; }
    .message-bot .message-content { background: #1E293B; color: #E2E8F0; border: 1px solid #334155; }
    .input-area { padding: 20px; background: #111827; border-top: 1px solid #1F2937; display: flex; gap: 12px; }
    .correction-btns { display: flex; gap: 8px; margin-top: 8px; }
    .correction-btns button { font-size: 12px; padding: 4px 12px; border-radius: 6px; cursor: pointer; border: none; }
    .btn-correct { background: #10B981; color: white; }
    .btn-wrong { background: #EF4444; color: white; }
    .loading { display: none; }
    .loading.active { display: inline-block; }
  </style>
</head>
<body>
  
  <div class="chat-container">
    <div style="padding: 16px 20px; background: #111827; border-bottom: 1px solid #1F2937; display: flex; align-items: center; justify-content: space-between;">
      <div>
        <h2 style="color: #60A5FA; font-size: 20px; font-weight: 600; margin: 0;">🤖 Train PropScholar Bot</h2>
        <p style="color: #9CA3AF; font-size: 14px; margin: 4px 0 0 0;">Chat, correct mistakes, auto-add to KB</p>
      </div>
      <a href="/admin-ui" style="color: #60A5FA; text-decoration: none; font-size: 14px;">← Back to Dashboard</a>
    </div>

    <div class="messages-area" id="messagesArea">
      <div style="text-align: center; color: #6B7280; margin-top: 40px;">
        <p style="font-size: 16px;">💬 Start chatting with the bot</p>
        <p style="font-size: 14px; margin-top: 8px;">Mark wrong answers to train the knowledge base</p>
      </div>
    </div>

    <div class="input-area">
      <input 
        type="text" 
        id="userInput" 
        placeholder="Ask the bot anything..." 
        class="input input-bordered w-full bg-[#1E293B] border-gray-600 text-white"
        onkeypress="if(event.key==='Enter') sendMessage()"
      />
      <button onclick="sendMessage()" class="btn btn-primary">
        <span class="loading loading-spinner loading-sm" id="loadingSpinner"></span>
        <span id="sendText">Send</span>
      </button>
    </div>
  </div>

  <script>
    let sessionId = 'admin-' + Date.now();

    function addUserMessage(text) {
      const messagesArea = document.getElementById('messagesArea');
      const msgDiv = document.createElement('div');
      msgDiv.className = 'message message-user';
      msgDiv.innerHTML = `<div class="message-content">${escapeHtml(text)}</div>`;
      messagesArea.appendChild(msgDiv);
      scrollToBottom();
    }

    function addBotMessage(text, conversationId, confidence) {
      const messagesArea = document.getElementById('messagesArea');
      const msgDiv = document.createElement('div');
      msgDiv.className = 'message message-bot';
      msgDiv.innerHTML = `
        <div class="message-content">
          <div>${escapeHtml(text)}</div>
          <div style="font-size: 11px; color: #64748B; margin-top: 8px;">
            Confidence: ${(confidence * 100).toFixed(1)}%
          </div>
          <div class="correction-btns">
            <button class="btn-correct" onclick="markCorrect('${conversationId}')">✓ Correct</button>
            <button class="btn-wrong" onclick="markWrong('${conversationId}')">✗ Wrong - Fix It</button>
          </div>
        </div>
      `;
      messagesArea.appendChild(msgDiv);
      scrollToBottom();
    }

    async function sendMessage() {
      const input = document.getElementById('userInput');
      const message = input.value.trim();
      
      if (!message) return;
      
      addUserMessage(message);
      input.value = '';
      showLoading(true);
      
      try {
        const res = await fetch('/admin-ui/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message, sessionId })
        });
        
        const data = await res.json();
        
        if (data.success) {
          addBotMessage(data.answer, data.conversationId, data.confidence || 0);
        } else {
          addBotMessage('❌ Error: ' + (data.error || 'Unknown error'), '', 0);
        }
      } catch (err) {
        console.error(err);
        addBotMessage('❌ Connection error. Try again.', '', 0);
      } finally {
        showLoading(false);
      }
    }

    async function markCorrect(conversationId) {
      try {
        await fetch('/admin-ui/feedback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ conversationId, isCorrect: true })
        });
        alert('✅ Marked as correct!');
      } catch (err) {
        alert('Error saving feedback');
      }
    }

    async function markWrong(conversationId) {
      const correction = prompt('What is the CORRECT answer?');
      if (!correction || !correction.trim()) return;
      
      try {
        const res = await fetch('/admin-ui/feedback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            conversationId, 
            isCorrect: false,
            correction: correction.trim()
          })
        });
        
        const data = await res.json();
        
        if (data.success) {
          alert('✅ Correction saved and added to Knowledge Base!');
        } else {
          alert('Error: ' + (data.error || 'Failed to save'));
        }
      } catch (err) {
        alert('Error saving correction');
      }
    }

    function showLoading(show) {
      document.getElementById('loadingSpinner').classList.toggle('active', show);
      document.getElementById('sendText').style.display = show ? 'none' : 'inline';
    }

    function scrollToBottom() {
      const area = document.getElementById('messagesArea');
      area.scrollTop = area.scrollHeight;
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }
  </script>

</body>
</html>
