<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PropScholar AI Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.4.24/dist/full.min.css" rel="stylesheet">
</head>

<body class="bg-base-200">
    <!-- Navbar -->
    <div class="navbar bg-base-100 shadow-xl">
        <div class="flex-1">
            <h1 class="text-3xl font-bold bg-gradient-to-r from-blue-500 to-purple-600 text-transparent bg-clip-text">
                PropScholar AI Dashboard
            </h1>
        </div>
        <div>
            <button onclick="refreshEmbeddings()" class="btn btn-primary btn-sm">🔄 Refresh Embeddings</button>
        </div>
    </div>

    <div class="container mx-auto p-6">

        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
            <div class="stat bg-base-100 shadow-lg rounded-xl">
                <div class="stat-title">Total KBs</div>
                <div class="stat-value text-primary"><%= docs.length %></div>
            </div>

            <div class="stat bg-base-100 shadow-lg rounded-xl">
                <div class="stat-title">Categories</div>
                <div class="stat-value text-secondary">
                    <%= [...new Set(docs.map(d => d.category))].length %>
                </div>
            </div>

            <div class="stat bg-base-100 shadow-lg rounded-xl">
                <div class="stat-title">Embeddings</div>
                <div class="stat-value text-accent">Active</div>
            </div>

            <div class="stat bg-base-100 shadow-lg rounded-xl">
                <div class="stat-title">Bot Status</div>
                <div id="bot-status" class="stat-value text-success">Online</div>
            </div>
        </div>

        <!-- Search + Add -->
        <div class="flex flex-col md:flex-row gap-4 mb-6">
            <input id="search" type="text" placeholder="Search knowledge base..."
                   class="input input-bordered w-full" onkeyup="searchKB()">
            <a href="/admin-ui/new" class="btn btn-success">➕ Add New KB</a>
        </div>

        <!-- Table -->
        <div class="bg-base-100 rounded-xl shadow-xl overflow-hidden">
            <div class="overflow-x-auto">
                <table class="table table-zebra w-full">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Preview</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="kbTable">
                    <% docs.forEach((d, i) => { %>
                        <tr class="kb-row hover">
                            <td><%= i + 1 %></td>
                            <td><%= d.title %></td>
                            <td><span class="badge badge-primary"><%= d.category %></span></td>
                            <td class="truncate max-w-xs"><%= d.content.substring(0, 80) %>...</td>
                            <td>
                                <div class="flex gap-2">
                                    <a href="/admin-ui/edit/<%= d._id %>"
                                       class="btn btn-info btn-xs">Edit</a>

                                    <a href="/admin-ui/delete/<%= d._id %>"
                                       onclick="return confirm('Delete this KB?')"
                                       class="btn btn-error btn-xs">Delete</a>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

<script>
    function searchKB() {
        const q = document.getElementById("search").value.toLowerCase();
        document.querySelectorAll(".kb-row").forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(q) ? "" : "none";
        });
    }

    async function refreshEmbeddings() {
        if (!confirm("Refresh all embeddings?")) return;
        const res = await fetch("/admin/refresh-embeddings", { method: "POST" });
        const data = await res.json();
        alert(data.message);
    }
</script>

</body>
</html>
