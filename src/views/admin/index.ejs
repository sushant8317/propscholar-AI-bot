<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PropScholar Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.4.24/dist/full.min.css" rel="stylesheet">
</head>

<body class="bg-base-200">

    <!-- NAVBAR -->
    <div class="navbar bg-base-100 shadow">
        <div class="flex-1">
            <h1 class="text-3xl font-bold bg-gradient-to-r from-blue-500 to-purple-600 text-transparent bg-clip-text">
                PropScholar AI Dashboard
            </h1>
        </div>
        <div>
            <button onclick="refreshEmbeddings()" class="btn btn-primary btn-sm">
                🔄 Refresh Embeddings
            </button>
        </div>
    </div>
        <a href="/admin-ui/chat" class="btn btn-accent btn-sm">
          💬 Train Bot
        </a>

    <div class="container mx-auto p-6">

        <!-- STATS -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">

            <div class="card card-black p-6 rounded-xl bg-base-100 shadow-lg">
                <div class="text-xl font-bold text-white">Total KBs</div>
                <div class="text-4xl font-extrabold text-primary"><%= total %></div>
            </div>

            <div class="card card-black p-6 rounded-xl bg-base-100 shadow-lg">
                <div class="text-xl font-bold text-white">Categories</div>
                <div class="text-4xl font-extrabold text-secondary"><%= categories.length %></div>
            </div>

            <div class="card card-black p-6 rounded-xl bg-base-100 shadow-lg">
                <div class="text-xl font-bold text-white">Embeddings</div>
                <div class="text-4xl font-extrabold text-accent">Active</div>
            </div>

            <div class="card card-black p-6 rounded-xl bg-base-100 shadow-lg">
                <div class="text-xl font-bold text-white">Bot Status</div>
                <div id="bot-status" class="text-4xl font-extrabold text-success">Online</div>
            </div>
        </div>

        <!-- SEARCH + ACTIONS -->
        <div class="flex flex-col md:flex-row gap-4 mb-6">
            <input id="search" placeholder="🔍 Search..." class="input input-bordered w-full" onkeyup="searchKB()">

            <button onclick="deleteSelected()" class="btn btn-error">
                🗑 Delete Selected
            </button>

            <a href="/admin-ui/new" class="btn btn-success">
                ➕ Add New KB
            </a>
        </div>

        <!-- TABLE -->
        <div class="bg-base-100 rounded-xl shadow-xl overflow-hidden">
            <table class="table table-zebra w-full">
                <thead>
                    <tr>
                        <th>
                            <input type="checkbox" onclick="toggleAll(this)" />
                        </th>
                        <th>#</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Preview</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="kbTable">

                <% docs.forEach((d, i) => { %>
                    <tr class="hover kb-row">
                        <td>
                            <input type="checkbox" class="selectItem" value="<%= d._id %>">
                        </td>

                        <td><%= i+1 %></td>

                        <td class="font-semibold"><%= d.title %></td>

                        <td>
                            <span class="badge badge-primary"><%= d.category %></span>
                        </td>

                        <td class="max-w-xs truncate">
                            <%= d.content.substring(0, 80) %>...
                        </td>

                        <td>
                            <a href="/admin-ui/edit/<%= d._id %>" class="btn btn-info btn-xs">Edit</a>
                            <a href="/admin-ui/delete/<%= d._id %>" class="btn btn-error btn-xs">Delete</a>
                        </td>
                    </tr>
                <% }) %>

                </tbody>
            </table>
        </div>

    </div>

    <script>
        function toggleAll(master) {
            document.querySelectorAll(".selectItem")
                .forEach(x => x.checked = master.checked);
        }

        function searchKB() {
            const q = document.getElementById("search").value.toLowerCase();
            document.querySelectorAll(".kb-row").forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(q) ? "" : "none";
            });
        }

        async function deleteSelected() {
            const ids = [...document.querySelectorAll(".selectItem:checked")].map(x => x.value);

            if (ids.length === 0)
                return alert("No KBs selected.");

            if (!confirm("Delete selected KBs?"))
                return;

            const res = await fetch("/admin-ui/delete-multiple", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ ids })
            });

            const data = await res.json();

            if (data.success) {
                alert("Deleted " + data.deleted + " items");
                location.reload();
            }
        }
    </script>

</body>
</html>
