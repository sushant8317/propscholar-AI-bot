<!DOCTYPE html>
<html lang="en" data-theme="business">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PropScholar AI Dashboard</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.4.24/dist/full.min.css" rel="stylesheet">

    <style>
        body {
            background: #000;
        }
        .card-black {
            background: #0a0a0a !important;
            border: 1px solid #111;
            box-shadow: 0 0 20px rgba(0,0,0,0.5);
        }
        .neon {
            color: #4cfaff;
        }
    </style>
</head>

<body class="text-gray-200">

    <div class="navbar bg-black border-b border-gray-800 shadow-xl">
        <div class="flex-1">
            <h1 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-purple-600">
                PropScholar AI Dashboard
            </h1>
        </div>

        <button onclick="refreshEmbeddings()" class="btn btn-info btn-sm">Refresh Embeddings</button>
    </div>

    <div class="p-8">

        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
            <div class="card card-black p-6 rounded-xl">
                <div class="text-lg">Total KBs</div>
                <div class="text-4xl font-bold neon"><%= docs.length %></div>
            </div>

            <div class="card card-black p-6 rounded-xl">
                <div class="text-lg">Categories</div>
                <div class="text-4xl font-bold neon"><%= categories %></div>
            </div>

            <div class="card card-black p-6 rounded-xl">
                <div class="text-lg">Embeddings</div>
                <div class="text-4xl font-bold text-green-400">Active</div>
            </div>

            <div class="card card-black p-6 rounded-xl">
                <div class="text-lg">Bot Status</div>
                <div id="bot-status" class="text-4xl font-bold text-green-400">Online</div>
            </div>
        </div>


        <!-- Tools -->
        <div class="flex items-center justify-between mb-4">
            <input id="search" onkeyup="searchKB()"
                   placeholder="Search..."
                   class="input input-bordered w-1/3 bg-black border-gray-700"/>

            <div class="flex items-center gap-3">
                <button id="deleteSelected" class="btn btn-error btn-sm hidden" onclick="deleteSelectedKB()">
                    Delete Selected
                </button>

                <a href="/admin/new" class="btn btn-success btn-sm">Add New KB</a>
            </div>
        </div>


        <!-- Table -->
        <div class="overflow-x-auto rounded-xl">
            <table class="table w-full text-gray-300">
                <thead class="bg-black border-b border-gray-800">
                    <tr>
                        <th><input type="checkbox" id="selectAll" onclick="toggleAll(this)" /></th>
                        <th>#</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Preview</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="kbTable">
                    <% docs.forEach((d, i) => { %>
                    <tr class="hover:bg-gray-900">
                        <td>
                            <input type="checkbox" class="selectItem" value="<%= d._id %>" onclick="toggleDeleteButton()"/>
                        </td>
                        <td><%= i + 1 %></td>

                        <td class="font-semibold text-white"><%= d.title %></td>

                        <td>
                            <span class="badge badge-info"><%= d.category %></span>
                        </td>

                        <td class="max-w-xs truncate text-gray-400">
                            <%= d.content.substring(0, 90) %>...
                        </td>

                        <td>
                            <a href="/admin/edit/<%= d._id %>" class="btn btn-info btn-xs">Edit</a>
                            <a href="/admin/delete/<%= d._id %>" class="btn btn-error btn-xs"
                               onclick="return confirm('Delete this KB?')">Delete</a>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

    </div>

<script>

function toggleAll(src) {
    const items = document.querySelectorAll('.selectItem');
    items.forEach(i => i.checked = src.checked);
    toggleDeleteButton();
}

function toggleDeleteButton() {
    const selected = document.querySelectorAll('.selectItem:checked').length;
    const btn = document.getElementById('deleteSelected');
    btn.classList.toggle("hidden", selected === 0);
}

async function deleteSelectedKB() {
    if (!confirm("Delete selected KBs?")) return;

    const ids = [...document.querySelectorAll('.selectItem:checked')].map(x=>x.value);

    const res = await fetch('/admin/delete-multiple', {
        method: 'POST',
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ids })
    });

    location.reload();
}

</script>

</body>
</html>
