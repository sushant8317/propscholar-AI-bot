<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <title>Edit KB</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="p-10">

<h1 class="text-3xl mb-5">Edit Knowledge Base</h1>

<form action="/admin-ui/edit/<%= doc._id %>" method="POST" class="space-y-4">

  <input name="title" value="<%= doc.title %>" class="input input-bordered w-full" />

  <input name="category" value="<%= doc.category %>" class="input input-bordered w-full" />

  <textarea name="content" class="textarea textarea-bordered w-full h-40"><%= doc.content %></textarea>

  <button class="btn btn-primary">Update</button>

</form>

</body>
</html>
