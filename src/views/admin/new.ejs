<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <title>Add KB</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="p-10">

<h1 class="text-3xl mb-5">Add Knowledge Base Entry</h1>

<form action="/admin-ui/new" method="POST" class="space-y-4">

  <input name="title" placeholder="Title" class="input input-bordered w-full" />

  <input name="category" placeholder="Category" class="input input-bordered w-full" />

  <textarea name="content" placeholder="Content" class="textarea textarea-bordered w-full h-40"></textarea>

  <button class="btn btn-primary">Save</button>

</form>

</body>
</html>
